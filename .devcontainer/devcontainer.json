{
  "name": "research-agent",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.terminal.activateEnvironment": false,
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "jupyter.jupyterServerType": "local"
      }
    }
  },
  "postCreateCommand": "python -m pip install -U pip && python -m pip install -e . pytest pytest-asyncio pytest-cov && rm -rf ~/.local/share/jupyter/kernels/research-agent",
  "postStartCommand": "rm -rf ~/.local/share/jupyter/kernels/research-agent",
  "forwardPorts": [8888, 11434],
  "remoteUser": "vscode"
}
